{
  "name": "oled-hunt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app/src/tv3d.src.js --bundle --format=esm --minify --target=safari15 --outfile=app/tv3d.js && esbuild app/src/seal.src.js --bundle --format=esm --minify --target=safari15 --outfile=app/seal.js",
    "site": "node scripts/build-site.mjs",
    "serve": "npm run site && npx --yes http-server _site -p 8080 -c-1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "0.186.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-sealedbox-js": "^1.2.0",
    "libsodium-wrappers": "^0.7.15"
  }
}
